{
  "name": "fastappshipkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-agent starter kit for shipping mobile apps. Command contract, compiler, and shared Supabase backend.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:commands": "node scripts/lint-commands.mjs",
    "lint": "eslint",
    "tsc": "tsc --noEmit",
    "compile": "node scripts/compile-commands.mjs",
    "test:backend": "node --test backend/supabase/tests/*.test.ts",
    "test:billing": "node --experimental-strip-types --test platforms/expo/template/src/features/billing/useEntitlement.test.ts platforms/expo/template/src/features/billing/paywall.test.ts",
    "test:analytics": "node --experimental-strip-types --test platforms/expo/template/src/lib/analytics.test.ts",
    "test:ai": "node --experimental-strip-types --test platforms/expo/template/src/features/ai/aiClient.test.ts platforms/expo/template/src/features/ai/hooks.test.ts",
    "test:permissions": "node --experimental-strip-types --test platforms/expo/template/src/features/permissions/usePermissionFlow.test.ts",
    "test:design": "node --experimental-strip-types --test platforms/expo/template/src/design/buildScreen.test.ts",
    "test:i18n": "node --experimental-strip-types --test platforms/expo/template/src/i18n/i18n.test.ts",
    "test:legal": "node --experimental-strip-types --test platforms/expo/template/src/legal/draft.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
