# Public RevenueCat SDK keys. Leave blank until the paywall command fills .env.
# Do not put a RevenueCat secret API key in this file or in the app.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Public project values. Consent stays off until the person enables it in settings.
# Do not put a PostHog personal API key or SENTRY_AUTH_TOKEN in this file.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=

# Public Supabase values for the AI proxy. The OpenRouter key is a Supabase secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
