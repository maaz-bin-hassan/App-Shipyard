{
  "id": "android",
  "name": "Android native",
  "language": "Kotlin",
  "storeTargets": ["play"],
  "templateDir": "platforms/android/template",
  "commands": ["start", "env-check", "plan-pricing", "paywall", "analytics", "ai", "design", "translate", "legal", "publish", "update"],
  "envChecks": [
    {
      "command": "java -version",
      "expected": "version",
      "install": {
        "windows": "Minimum: 17. winget install -e --id Microsoft.OpenJDK.17",
        "macos": "Minimum: 17. brew install --cask zulu@17",
        "linux": "Minimum: 17. sudo apt-get install -y openjdk-17-jdk"
      }
    },
    {
      "command": "adb version",
      "expected": "Android Debug Bridge",
      "install": {
        "windows": "Minimum: Android SDK Platform-Tools. sdkmanager \"platform-tools\"",
        "macos": "Minimum: Android SDK Platform-Tools. sdkmanager \"platform-tools\"",
        "linux": "Minimum: Android SDK Platform-Tools. sdkmanager \"platform-tools\""
      }
    },
    {
      "command": "node scripts/android-sdk-platform.mjs 36",
      "expected": "android-sdk-36",
      "install": {
        "windows": "Minimum: Android SDK Platform 36. sdkmanager \"platforms;android-36\" \"platform-tools\"",
        "macos": "Minimum: Android SDK Platform 36. sdkmanager \"platforms;android-36\" \"platform-tools\"",
        "linux": "Minimum: Android SDK Platform 36. sdkmanager \"platforms;android-36\" \"platform-tools\""
      }
    }
  ],
  "services": {
    "auth": "supabase",
    "billing": "revenuecat",
    "analytics": "posthog",
    "crashes": "sentry"
  },
  "buildTool": "gradle",
  "releaseTool": "gradle",
  "stringsFormat": "xml",
  "permissionsFile": "app/src/main/AndroidManifest.xml"
}
